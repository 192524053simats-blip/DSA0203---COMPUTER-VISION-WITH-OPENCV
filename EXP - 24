from google.colab import files
uploaded = files.upload()

import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read uploaded image
image_path = list(uploaded.keys())[0]
img = cv2.imread(image_path)

if img is None:
    print("Error: Image could not be read.")
else:

    # High-boost filter
    boost_factor = 1.5

    # 3x3 averaging kernel
    kernel = np.ones((3, 3), dtype=np.float32) / 9

    # Blur image
    blur = cv2.filter2D(img, -1, kernel)

    # Convert to float for calculation
    image_float = img.astype(np.float32)
    blur_float = blur.astype(np.float32)

    # High-boost calculation
    high_boost = image_float + boost_factor * (image_float - blur_float)

    # Keep pixel values between 0 and 255
    high_boost = np.clip(high_boost, 0, 255).astype(np.uint8)

    # Input
    plt.figure(figsize=(6, 5))
    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    plt.title("Input Image")
    plt.axis("off")
    plt.show()

    # Output
    plt.figure(figsize=(6, 5))
    plt.imshow(cv2.cvtColor(high_boost, cv2.COLOR_BGR2RGB))
    plt.title("Output - High-Boost Sharpening")
    plt.axis("off")
    plt.show()
