from google.colab import files
uploaded = files.upload()

import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read uploaded image
image_path = list(uploaded.keys())[0]
image = cv2.imread(image_path)

if image is None:
    print("Error: Image could not be read.")
else:

    # Convert to grayscale
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

    # Sobel gradient in X direction
    gradient_x = cv2.Sobel(
        gray,
        cv2.CV_64F,
        1,
        0,
        ksize=3
    )

    # Sobel gradient in Y direction
    gradient_y = cv2.Sobel(
        gray,
        cv2.CV_64F,
        0,
        1,
        ksize=3
    )

    # Subtract gradients as specified in the manual
    gradient = cv2.subtract(gradient_x, gradient_y)

    # Convert for proper display
    gradient_display = cv2.convertScaleAbs(gradient)

    # Input
    plt.figure(figsize=(6, 5))
    plt.imshow(cv2.cvtColor(image, cv2.COLOR_BGR2RGB))
    plt.title("Input Image")
    plt.axis("off")
    plt.show()

    # Output
    plt.figure(figsize=(6, 5))
    plt.imshow(gradient_display, cmap="gray")
    plt.title("Output - Gradient Masking")
    plt.axis("off")
    plt.show()
