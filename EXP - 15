from google.colab import files
uploaded = files.upload()

import cv2
import numpy as np
import matplotlib.pyplot as plt

image_path=list(uploaded.keys())[0]

img=cv2.imread(image_path)
img=cv2.cvtColor(img,cv2.COLOR_BGR2RGB)

rows,cols=img.shape[:2]

src=np.float32([[0,0],
                [cols-1,0],
                [cols-1,rows-1],
                [0,rows-1]])

dst=np.float32([[50,50],
                [cols-50,20],
                [cols-20,rows-20],
                [20,rows-50]])

# DLT-based homography estimation
H, mask = cv2.findHomography(src, dst, method=0)

dlt=cv2.warpPerspective(img,H,(cols,rows))

plt.figure(figsize=(6,6))
plt.imshow(img)
plt.title("Input Image")
plt.axis("off")
plt.show()

plt.figure(figsize=(6,6))
plt.imshow(dlt)
plt.title("Output - Direct Linear Transformation (DLT)")
plt.axis("off")
plt.show()
